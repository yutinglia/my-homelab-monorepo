{
    "name": "@homelab/profile",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev --port 5174",
        "build": "vite build",
        "preview": "vite preview --port 4174",
        "generate:i18n": "paraglide-js compile --project ../project.inlang --outdir ./src/lib/paraglide --strategy url cookie baseLocale --emit-ts-declarations --silent",
        "check": "pnpm generate:i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
    },
    "dependencies": {
        "@homelab/shared": "workspace:*",
        "bits-ui": "catalog:",
        "clsx": "catalog:",
        "tailwind-merge": "catalog:",
        "tailwind-variants": "catalog:"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "catalog:",
        "@sveltejs/adapter-static": "catalog:",
        "@sveltejs/kit": "catalog:",
        "@sveltejs/vite-plugin-svelte": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@types/node": "catalog:",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:"
    }
}
